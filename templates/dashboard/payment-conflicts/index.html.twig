{% extends 'dashboard.html.twig' %}

{% block title %}Dashboard - Conflits de créneaux{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">⚠️ Conflits de créneaux</h1>
        <p class="text-sm text-gray-600">Paiements reçus pour un créneau déjà pris entre-temps — remboursement à traiter.</p>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 px-4 py-3 rounded-lg text-sm font-medium
                {{ label == 'success' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Conflits en attente -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">
                À traiter <span class="text-sm font-normal text-gray-500">({{ conflictRows|length }})</span>
            </h2>
        </div>

        {% if conflictRows|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-red-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-red-600 uppercase tracking-wider">Client</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-red-600 uppercase tracking-wider">Créneau demandé</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-red-600 uppercase tracking-wider">Référence</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-red-600 uppercase tracking-wider">Montant</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-red-600 uppercase tracking-wider">Provider</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-red-600 uppercase tracking-wider">Détecté le</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-red-600 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for row in conflictRows %}
                            {% set payment = row.payment %}
                            {% set entity = row.entity %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4">
                                    {% if payment.customer %}
                                        <div class="text-sm font-medium text-gray-900">{{ payment.customer.fullName }}</div>
                                        <div class="text-xs text-gray-500">{{ payment.customer.email }}</div>
                                    {% else %}
                                        <span class="text-sm text-gray-400">Client supprimé</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700 whitespace-nowrap">
                                    {% if entity and entity.day %}
                                        {{ entity.day|date('d/m/Y') }} à {{ entity.creneau.startTime|date('H:i') }}
                                    {% else %}
                                        <span class="text-gray-400">N/A</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4">
                                    <code class="text-xs bg-gray-100 px-2 py-1 rounded">{{ payment.reference }}</code>
                                </td>
                                <td class="px-6 py-4 text-sm font-semibold text-gray-900">
                                    {{ (payment.amount / 100)|number_format(0, ',', ' ') }} {{ payment.currency }}
                                </td>
                                <td class="px-6 py-4">
                                    {% if payment.provider == 'feexpay' %}
                                        <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">💸 FeexPay</span>
                                    {% elseif payment.provider == 'fedapay' %}
                                        <span class="px-2 py-1 text-xs font-medium bg-indigo-100 text-indigo-800 rounded-full">🏦 FedaPay</span>
                                    {% else %}
                                        <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">{{ payment.provider|title }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">{{ payment.updatedAt ? payment.updatedAt|date('d/m/Y H:i') : '—' }}</td>
                                <td class="px-6 py-4 text-right">
                                    <form method="POST" action="{{ path('app_dashboard_payment_conflicts_resolve', {'id': payment.id}) }}"
                                          onsubmit="return confirm('Confirmer que le remboursement de {{ (payment.amount / 100)|number_format(0, ',', ' ') }} {{ payment.currency }} a bien été effectué ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('payment_conflict_resolve_' ~ payment.id) }}">
                                        <button type="submit"
                                                class="inline-flex items-center px-3 py-1.5 text-xs font-medium text-green-700 bg-green-50 border border-green-200 rounded-lg hover:bg-green-100 transition-colors">
                                            ✅ Remboursement effectué
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="px-6 py-12 text-center">
                <svg class="mx-auto h-12 w-12 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p class="mt-2 text-sm text-gray-500">Aucun conflit en attente. 🎉</p>
            </div>
        {% endif %}
    </div>

    <!-- Historique des remboursements -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Historique des remboursements</h2>
        </div>

        {% if resolvedRows|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Client</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Référence</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Montant</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Remboursé le</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for row in resolvedRows %}
                            {% set payment = row.payment %}
                            <tr>
                                <td class="px-6 py-4">
                                    {% if payment.customer %}
                                        <div class="text-sm text-gray-700">{{ payment.customer.fullName }}</div>
                                    {% else %}
                                        <span class="text-sm text-gray-400">Client supprimé</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4">
                                    <code class="text-xs bg-gray-100 px-2 py-1 rounded">{{ payment.reference }}</code>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700">
                                    {{ (payment.amount / 100)|number_format(0, ',', ' ') }} {{ payment.currency }}
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">{{ payment.updatedAt ? payment.updatedAt|date('d/m/Y H:i') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="px-6 py-8 text-center text-sm text-gray-500">Aucun remboursement enregistré pour l'instant.</div>
        {% endif %}
    </div>
</div>
{% endblock %}
