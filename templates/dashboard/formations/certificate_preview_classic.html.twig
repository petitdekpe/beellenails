{% extends 'dashboard.html.twig' %}

{% block title %}Prévisualisation — Modèle Classique{% endblock %}

{% block content %}
<div class="space-y-4">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Modèle Classique</h1>
            <p class="text-sm text-gray-500">Rose & sombre — style académique BelleNails Academy</p>
        </div>
        <div class="flex gap-3">
            <a href="{{ path('app_dashboard_formation_certificate_preview', {template: 'default'}) }}"
               class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                ← Voir Modèle Élégant
            </a>
            <a href="javascript:history.back()"
               class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                ← Retour
            </a>
        </div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 text-sm text-amber-800">
        Ceci est une prévisualisation avec des données fictives. Le PDF généré contiendra les vraies informations de l'apprenant et de la formation.
    </div>

    <!-- Certificate preview -->
    <div class="bg-white rounded-lg shadow-sm p-4 overflow-auto">
        <div class="min-w-[700px]">

            <!-- Certificate container -->
            <div style="
                font-family: Georgia, 'Times New Roman', serif;
                background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 50%, #cbd5e1 100%);
                padding: 24px;
                border-radius: 12px;
            ">
                <div style="
                    position: relative;
                    background: white;
                    border: 12px solid #1e293b;
                    border-radius: 4px;
                    overflow: hidden;
                ">
                    <div style="
                        position: relative;
                        border: 6px solid #ec4899;
                        margin: 0;
                        padding: 40px 50px 100px;
                        background:
                            radial-gradient(circle at 20% 20%, rgba(236,72,153,0.05) 0%, transparent 50%),
                            radial-gradient(circle at 80% 80%, rgba(139,92,246,0.05) 0%, transparent 50%),
                            linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
                        text-align: center;
                    ">
                        <!-- Decorative corners -->
                        <div style="position:absolute;top:12px;left:12px;width:50px;height:50px;border-top:3px solid #ec4899;border-left:3px solid #ec4899;"></div>
                        <div style="position:absolute;top:12px;right:12px;width:50px;height:50px;border-top:3px solid #ec4899;border-right:3px solid #ec4899;"></div>
                        <div style="position:absolute;bottom:12px;left:12px;width:50px;height:50px;border-bottom:3px solid #ec4899;border-left:3px solid #ec4899;"></div>
                        <div style="position:absolute;bottom:12px;right:12px;width:50px;height:50px;border-bottom:3px solid #ec4899;border-right:3px solid #ec4899;"></div>

                        <!-- Achievement badge -->
                        <div style="
                            position: absolute; top: 60px; right: 60px;
                            width: 72px; height: 72px; border-radius: 50%;
                            background: linear-gradient(135deg, #fbbf24, #f59e0b);
                            border: 4px solid #92400e;
                            display: flex; align-items: center; justify-content: center;
                            font-size: 32px;
                        ">🏆</div>

                        <!-- Watermark -->
                        <div style="
                            position: absolute; top: 50%; left: 50%;
                            transform: translate(-50%, -50%) rotate(-45deg);
                            font-size: 90px; color: rgba(236,72,153,0.04);
                            font-weight: bold; pointer-events: none; white-space: nowrap;
                        ">BELLENAILS</div>

                        <!-- Header -->
                        <div style="position: relative; z-index: 1;">
                            <div style="font-size: 30px; font-weight: bold; color: #ec4899; margin-bottom: 8px; text-shadow: 1px 1px 2px rgba(0,0,0,0.1);">
                                💅 BelleNails Academy
                            </div>
                            <div style="font-size: 42px; font-weight: bold; color: #1e293b; text-transform: uppercase; letter-spacing: 4px; margin: 16px 0 8px; text-shadow: 2px 2px 4px rgba(0,0,0,0.08);">
                                Certificat
                            </div>
                            <div style="font-size: 18px; color: #64748b; font-style: italic; margin-bottom: 28px;">
                                de Réussite Professionnelle
                            </div>

                            <!-- Content -->
                            <div style="font-size: 20px; color: #374151; margin-bottom: 16px; line-height: 1.6;">
                                Il est certifié par les présentes que
                            </div>

                            <div style="
                                font-size: 38px; font-weight: bold; color: #ec4899; margin: 24px 0;
                                text-decoration: underline; text-decoration-color: #8b5cf6;
                                text-decoration-thickness: 3px; text-underline-offset: 8px;
                            ">
                                Marie Dupont
                            </div>

                            <div style="font-size: 18px; color: #374151; margin-bottom: 16px;">
                                a suivi avec succès et terminé la formation
                            </div>

                            <div style="font-size: 26px; font-weight: bold; color: #1e293b; font-style: italic; margin: 20px 0;">
                                "Formation Prothésie Ongulaire Avancée"
                            </div>

                            <div style="font-size: 20px; color: #ec4899; margin: 16px 0; letter-spacing: 6px;">❋ ❋ ❋</div>

                            <!-- Level -->
                            <div style="margin: 16px 0; font-size: 15px; color: #4b5563;">
                                <div style="font-weight: bold; margin-bottom: 6px; color: #374151;">Niveau de Formation</div>
                                <div>Intermédiaire</div>
                            </div>

                            <!-- Completion details -->
                            <div style="margin: 20px 0; font-size: 14px; color: #6b7280;">
                                Formation complétée à <strong style="color: #374151;">100%</strong><br>
                                Durée totale d'étude : <strong style="color: #374151;">8h</strong>
                            </div>

                            <div style="font-size: 16px; color: #374151; font-weight: 600;">
                                Délivrée le 09 mai 2025
                            </div>
                        </div>

                        <!-- Footer -->
                        <div style="
                            position: absolute; bottom: 30px; left: 0; right: 0;
                            display: flex; justify-content: space-around; align-items: center;
                            padding: 0 60px;
                        ">
                            <div style="text-align: center; flex: 1;">
                                <div style="border-bottom: 2px solid #374151; width: 180px; margin: 0 auto 8px;"></div>
                                <div style="font-size: 13px; color: #6b7280; font-weight: 600;">Directrice Pédagogique</div>
                            </div>
                            <div style="text-align: center; flex: 1;">
                                <div style="border-bottom: 2px solid #374151; width: 180px; margin: 0 auto 8px;"></div>
                                <div style="font-size: 13px; color: #6b7280; font-weight: 600;">BelleNails Academy</div>
                            </div>
                        </div>

                        <!-- Certificate ID -->
                        <div style="
                            position: absolute; bottom: 10px; right: 20px;
                            font-size: 11px; color: #9ca3af; font-family: monospace;
                        ">
                            Certificat N° 000042-2025
                        </div>

                        <!-- QR placeholder -->
                        <div style="
                            position: absolute; bottom: 16px; left: 20px;
                            width: 52px; height: 52px;
                            border: 2px solid #e5e7eb;
                            display: flex; align-items: center; justify-content: center;
                            font-size: 9px; color: #9ca3af; text-align: center;
                            font-family: Arial, sans-serif;
                        ">
                            QR<br>Vérif.
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <p class="text-xs text-center text-gray-400">
        Le PDF final sera généré en format A4 paysage. Les couleurs et proportions peuvent légèrement varier à l'impression.
    </p>
</div>
{% endblock %}
