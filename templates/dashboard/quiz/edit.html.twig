{% extends 'dashboard.html.twig' %}

{% block title %}{{ quiz ? 'Modifier' : 'Créer' }} le quiz - {{ module.title }}{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 py-6">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">{{ quiz ? 'Modifier' : 'Créer' }} le quiz</h1>
        <p class="text-sm text-gray-500 mt-1">Module : {{ module.title }}</p>
    </div>

    <form method="POST" id="quiz-form">

        <!-- Paramètres -->
        <div class="bg-white rounded-lg shadow mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Paramètres du quiz</h2>
            </div>
            <div class="px-6 py-4 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Score minimum (%)</label>
                    <input type="number" name="passing_score" min="0" max="100"
                           value="{{ quiz ? quiz.passingScore : 70 }}"
                           class="block w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-1 focus:ring-pink-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Tentatives max (vide = illimité)</label>
                    <input type="number" name="max_attempts" min="1"
                           value="{{ quiz and quiz.maxAttempts is not null ? quiz.maxAttempts : '' }}"
                           placeholder="Illimité"
                           class="block w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-1 focus:ring-pink-500">
                </div>
                <div class="flex items-end">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="is_active" value="1"
                               {{ (not quiz or quiz.isActive) ? 'checked' : '' }}
                               class="w-4 h-4 text-pink-600 rounded">
                        <span class="text-sm font-medium text-gray-700">Quiz actif</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Questions -->
        <div class="bg-white rounded-lg shadow mb-6">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h2 class="text-lg font-medium text-gray-900">Questions</h2>
                <button type="button" id="add-question"
                        class="inline-flex items-center px-3 py-1.5 bg-pink-600 hover:bg-pink-700 text-white text-sm font-medium rounded-lg transition-colors">
                    + Ajouter une question
                </button>
            </div>
            <div id="questions-container" class="divide-y divide-gray-100">
                {% if quiz %}
                    {% for question in quiz.questions %}
                        {{ _self.question_block(loop.index0, question) }}
                    {% endfor %}
                {% endif %}
            </div>
            <div id="no-questions" class="px-6 py-8 text-center text-gray-400 {{ (quiz and quiz.questions|length > 0) ? 'hidden' : '' }}">
                Cliquez sur "Ajouter une question" pour commencer.
            </div>
        </div>

        <div class="flex gap-3">
            <button type="submit"
                    class="px-6 py-2 bg-pink-600 hover:bg-pink-700 text-white font-medium rounded-lg transition-colors">
                Enregistrer le quiz
            </button>
            <a href="{{ path('app_quiz_show', {'id': module.id}) }}"
               class="px-6 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors">
                Annuler
            </a>
        </div>

    </form>
</div>

{% macro question_block(index, question) %}
<div class="question-block px-6 py-4" data-index="{{ index }}">
    <div class="flex items-center justify-between mb-3">
        <span class="text-sm font-semibold text-gray-700">Question <span class="q-number">{{ index + 1 }}</span></span>
        <button type="button" class="remove-question text-red-500 hover:text-red-700 text-sm">Supprimer</button>
    </div>

    <div class="mb-3">
        <textarea name="questions[{{ index }}][text]" rows="2" placeholder="Texte de la question"
                  class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-pink-500"
                  required>{{ question ? question.questionText : '' }}</textarea>
    </div>

    <div class="flex gap-4 mb-3">
        <label class="flex items-center gap-1.5 text-sm cursor-pointer">
            <input type="radio" name="questions[{{ index }}][type]" value="single"
                   {{ (not question or question.type == 'single') ? 'checked' : '' }}
                   class="text-pink-600"> Choix unique
        </label>
        <label class="flex items-center gap-1.5 text-sm cursor-pointer">
            <input type="radio" name="questions[{{ index }}][type]" value="multiple"
                   {{ (question and question.type == 'multiple') ? 'checked' : '' }}
                   class="text-pink-600"> Choix multiple
        </label>
    </div>

    <div class="answers-container space-y-2 mb-3">
        {% if question %}
            {% for answer in question.answers %}
            <div class="flex items-center gap-2">
                <input type="checkbox" name="questions[{{ index }}][answers][{{ loop.index0 }}][correct]" value="1"
                       {{ answer.isCorrect ? 'checked' : '' }}
                       class="w-4 h-4 text-green-500 rounded flex-shrink-0">
                <input type="text" name="questions[{{ index }}][answers][{{ loop.index0 }}][text]"
                       value="{{ answer.answerText }}" placeholder="Réponse"
                       class="flex-1 rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-pink-500"
                       required>
                <button type="button" class="remove-answer text-gray-400 hover:text-red-500 flex-shrink-0">✕</button>
            </div>
            {% endfor %}
        {% else %}
            <div class="flex items-center gap-2">
                <input type="checkbox" name="questions[{{ index }}][answers][0][correct]" value="1" class="w-4 h-4 text-green-500 rounded flex-shrink-0">
                <input type="text" name="questions[{{ index }}][answers][0][text]" placeholder="Réponse" required
                       class="flex-1 rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-pink-500">
                <button type="button" class="remove-answer text-gray-400 hover:text-red-500 flex-shrink-0">✕</button>
            </div>
            <div class="flex items-center gap-2">
                <input type="checkbox" name="questions[{{ index }}][answers][1][correct]" value="1" class="w-4 h-4 text-green-500 rounded flex-shrink-0">
                <input type="text" name="questions[{{ index }}][answers][1][text]" placeholder="Réponse" required
                       class="flex-1 rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-pink-500">
                <button type="button" class="remove-answer text-gray-400 hover:text-red-500 flex-shrink-0">✕</button>
            </div>
        {% endif %}
    </div>

    <button type="button" class="add-answer text-sm text-pink-600 hover:text-pink-800">+ Ajouter une réponse</button>

    <div class="mt-3">
        <input type="text" name="questions[{{ index }}][explanation]"
               value="{{ question ? question.explanation : '' }}"
               placeholder="Explication (optionnel, affichée dans la correction)"
               class="block w-full rounded-lg border border-gray-200 bg-blue-50 px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-blue-400">
    </div>
</div>
{% endmacro %}

{% endblock %}

{% block javascripts %}
<script>
let questionCount = {{ quiz ? quiz.questions|length : 0 }};

function updateQuestionNumbers() {
    document.querySelectorAll('.question-block').forEach((block, i) => {
        block.dataset.index = i;
        block.querySelector('.q-number').textContent = i + 1;
        // Update all name attributes
        block.querySelectorAll('[name]').forEach(el => {
            el.name = el.name.replace(/questions\[\d+\]/, `questions[${i}]`);
        });
    });
    questionCount = document.querySelectorAll('.question-block').length;
    document.getElementById('no-questions').classList.toggle('hidden', questionCount > 0);
}

function createAnswerRow(qIndex, aIndex) {
    const div = document.createElement('div');
    div.className = 'flex items-center gap-2';
    div.innerHTML = `
        <input type="checkbox" name="questions[${qIndex}][answers][${aIndex}][correct]" value="1" class="w-4 h-4 text-green-500 rounded flex-shrink-0">
        <input type="text" name="questions[${qIndex}][answers][${aIndex}][text]" placeholder="Réponse" required
               class="flex-1 rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-pink-500">
        <button type="button" class="remove-answer text-gray-400 hover:text-red-500 flex-shrink-0">✕</button>`;
    return div;
}

function createQuestionBlock(index) {
    const div = document.createElement('div');
    div.className = 'question-block px-6 py-4 border-t border-gray-100';
    div.dataset.index = index;
    div.innerHTML = `
        <div class="flex items-center justify-between mb-3">
            <span class="text-sm font-semibold text-gray-700">Question <span class="q-number">${index + 1}</span></span>
            <button type="button" class="remove-question text-red-500 hover:text-red-700 text-sm">Supprimer</button>
        </div>
        <div class="mb-3">
            <textarea name="questions[${index}][text]" rows="2" placeholder="Texte de la question" required
                      class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-pink-500"></textarea>
        </div>
        <div class="flex gap-4 mb-3">
            <label class="flex items-center gap-1.5 text-sm cursor-pointer">
                <input type="radio" name="questions[${index}][type]" value="single" checked class="text-pink-600"> Choix unique
            </label>
            <label class="flex items-center gap-1.5 text-sm cursor-pointer">
                <input type="radio" name="questions[${index}][type]" value="multiple" class="text-pink-600"> Choix multiple
            </label>
        </div>
        <div class="answers-container space-y-2 mb-3"></div>
        <button type="button" class="add-answer text-sm text-pink-600 hover:text-pink-800">+ Ajouter une réponse</button>
        <div class="mt-3">
            <input type="text" name="questions[${index}][explanation]" placeholder="Explication (optionnel)"
                   class="block w-full rounded-lg border border-gray-200 bg-blue-50 px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-blue-400">
        </div>`;

    // Add 2 default answers
    const container = div.querySelector('.answers-container');
    container.appendChild(createAnswerRow(index, 0));
    container.appendChild(createAnswerRow(index, 1));

    return div;
}

document.getElementById('add-question').addEventListener('click', () => {
    const block = createQuestionBlock(questionCount);
    document.getElementById('questions-container').appendChild(block);
    questionCount++;
    document.getElementById('no-questions').classList.add('hidden');
});

document.getElementById('questions-container').addEventListener('click', e => {
    if (e.target.classList.contains('remove-question')) {
        e.target.closest('.question-block').remove();
        updateQuestionNumbers();
    }

    if (e.target.classList.contains('remove-answer')) {
        const row = e.target.closest('.flex');
        const container = row.closest('.answers-container');
        if (container.children.length > 2) {
            row.remove();
        }
    }

    if (e.target.classList.contains('add-answer')) {
        const block = e.target.closest('.question-block');
        const qIndex = block.dataset.index;
        const container = block.querySelector('.answers-container');
        const aIndex = container.children.length;
        container.appendChild(createAnswerRow(qIndex, aIndex));
    }
});
</script>
{% endblock %}
