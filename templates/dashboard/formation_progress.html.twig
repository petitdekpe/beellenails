{% extends 'dashboard.html.twig' %}

{% block title %}Progression formations - Dashboard{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">📊 Suivi des progressions</h1>
        <span class="text-sm text-gray-500">{{ enrollments|length }} apprenant{{ enrollments|length > 1 ? 's' : '' }} actif{{ enrollments|length > 1 ? 's' : '' }}</span>
    </div>

    {% set completedCount = 0 %}
    {% set inProgressCount = 0 %}
    {% set notStartedCount = 0 %}
    {% set totalProgress = 0 %}

    {% for enrollment in enrollments %}
        {% set progress = enrollment.progressPercentage|default(0) %}
        {% set totalProgress = totalProgress + progress %}
        {% if progress == 100 %}
            {% set completedCount = completedCount + 1 %}
        {% elseif progress > 0 %}
            {% set inProgressCount = inProgressCount + 1 %}
        {% else %}
            {% set notStartedCount = notStartedCount + 1 %}
        {% endif %}
    {% endfor %}

    {% set averageProgress = enrollments|length > 0 ? (totalProgress / enrollments|length) : 0 %}

    <!-- Progress Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-green-600 text-lg">🏆</span>
                </div>
                <div class="ml-4">
                    <p class="text-xs font-semibold text-green-600 uppercase tracking-wide">Formations terminées</p>
                    <p class="text-xl font-bold text-gray-900">{{ completedCount }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-blue-600 text-lg">▶️</span>
                </div>
                <div class="ml-4">
                    <p class="text-xs font-semibold text-blue-600 uppercase tracking-wide">En cours</p>
                    <p class="text-xl font-bold text-gray-900">{{ inProgressCount }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-yellow-600 text-lg">⏸️</span>
                </div>
                <div class="ml-4">
                    <p class="text-xs font-semibold text-yellow-600 uppercase tracking-wide">Non commencées</p>
                    <p class="text-xl font-bold text-gray-900">{{ notStartedCount }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-cyan-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-cyan-600 text-lg">📈</span>
                </div>
                <div class="ml-4">
                    <p class="text-xs font-semibold text-cyan-600 uppercase tracking-wide">Progression moyenne</p>
                    <p class="text-xl font-bold text-gray-900">{{ averageProgress|round }}%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress Table -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Détail des progressions</h3>
        </div>
        {% if enrollments|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-pink-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Apprenant</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Formation</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Inscription</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Progression</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Dernier accès</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Temps d'étude</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Statut</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-pink-600 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for enrollment in enrollments %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-gray-900">{{ enrollment.user.fullName }}</div>
                                <div class="text-xs text-gray-500">{{ enrollment.user.email }}</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-gray-900">{{ enrollment.formation.nom }}</div>
                                <div class="text-xs text-gray-500">{{ enrollment.formation.modules|length }} module{{ enrollment.formation.modules|length > 1 ? 's' : '' }}</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">{{ enrollment.enrolledAt|date('d/m/Y') }}</td>
                            <td class="px-6 py-4">
                                {% set progress = enrollment.progressPercentage|default(0) %}
                                <div class="flex items-center gap-2">
                                    <div class="flex-1 bg-gray-200 rounded-full h-2 min-w-[80px]">
                                        <div class="h-2 rounded-full
                                            {% if progress == 100 %}bg-green-500
                                            {% elseif progress >= 75 %}bg-cyan-500
                                            {% elseif progress >= 50 %}bg-yellow-500
                                            {% elseif progress >= 25 %}bg-blue-500
                                            {% else %}bg-gray-400
                                            {% endif %}"
                                             style="width: {{ progress }}%">
                                        </div>
                                    </div>
                                    <span class="text-sm font-semibold text-gray-900">{{ progress }}%</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">
                                {% if enrollment.lastAccessedAt %}
                                    <div class="whitespace-nowrap">{{ enrollment.lastAccessedAt|date('d/m/Y H:i') }}</div>
                                    <div class="text-xs text-gray-400">
                                        {% set daysSince = date().diff(enrollment.lastAccessedAt).days %}
                                        {% if daysSince == 0 %}
                                            Aujourd'hui
                                        {% elseif daysSince == 1 %}
                                            Hier
                                        {% else %}
                                            Il y a {{ daysSince }} jour{{ daysSince > 1 ? 's' : '' }}
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-gray-400">Jamais consulté</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">
                                {% set daysSinceEnrollment = date().diff(enrollment.enrolledAt).days %}
                                {{ daysSinceEnrollment }} jour{{ daysSinceEnrollment > 1 ? 's' : '' }}
                            </td>
                            <td class="px-6 py-4">
                                {% if enrollment.progressPercentage == 100 %}
                                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Terminé</span>
                                    {% if enrollment.completedAt %}
                                        <div class="text-xs text-gray-400 mt-1">{{ enrollment.completedAt|date('d/m/Y') }}</div>
                                    {% endif %}
                                {% elseif enrollment.progressPercentage > 0 %}
                                    <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">En cours</span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Non commencé</span>
                                {% endif %}

                                {% if enrollment.expiresAt and enrollment.expiresAt < date() %}
                                    <div class="mt-1"><span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">Expiré</span></div>
                                {% elseif enrollment.expiresAt %}
                                    {% set daysUntilExpiry = date().diff(enrollment.expiresAt).days %}
                                    {% if daysUntilExpiry <= 7 %}
                                        <div class="mt-1"><span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Expire dans {{ daysUntilExpiry }} j.</span></div>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('app_user_learning_formation_detail', {id: enrollment.formation.id}) }}"
                                       class="text-blue-600 hover:text-blue-900 transition-colors" title="Voir détails">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </a>
                                    <a href="{{ path('app_formation_show', {id: enrollment.formation.id}) }}"
                                       class="text-green-600 hover:text-green-900 transition-colors" title="Voir formation">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422A12.083 12.083 0 0112 21a12.083 12.083 0 01-6.16-10.422L12 14z"/>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="px-6 py-12 text-center text-gray-500">Aucune progression trouvée</div>
        {% endif %}
    </div>
</div>
{% endblock %}
