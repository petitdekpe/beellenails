{% extends 'dashboard.html.twig' %}

{% block title %}Paiements formations - Dashboard{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">💰 Paiements des formations</h1>
        <span class="text-sm text-gray-500">{{ payments|length }} paiement{{ payments|length > 1 ? 's' : '' }}</span>
    </div>

    <!-- Statistics Cards -->
    {% set successfulPayments = payments|filter(p => p.status == 'approved')|length %}
    {% set pendingPayments = payments|filter(p => p.status == 'pending')|length %}
    {% set failedPayments = payments|filter(p => p.status in ['declined', 'failed'])|length %}
    {% set totalAmount = 0 %}
    {% for payment in payments %}
        {% if payment.status == 'approved' %}
            {% set totalAmount = totalAmount + payment.amount %}
        {% endif %}
    {% endfor %}

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-green-600 text-lg">✅</span>
                </div>
                <div class="ml-4">
                    <p class="text-xs font-semibold text-green-600 uppercase tracking-wide">Paiements réussis</p>
                    <p class="text-xl font-bold text-gray-900">{{ successfulPayments }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-yellow-600 text-lg">⏳</span>
                </div>
                <div class="ml-4">
                    <p class="text-xs font-semibold text-yellow-600 uppercase tracking-wide">En attente</p>
                    <p class="text-xl font-bold text-gray-900">{{ pendingPayments }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-red-600 text-lg">❌</span>
                </div>
                <div class="ml-4">
                    <p class="text-xs font-semibold text-red-600 uppercase tracking-wide">Paiements échoués</p>
                    <p class="text-xl font-bold text-gray-900">{{ failedPayments }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-blue-600 text-lg">💵</span>
                </div>
                <div class="ml-4">
                    <p class="text-xs font-semibold text-blue-600 uppercase tracking-wide">Revenus total</p>
                    <p class="text-xl font-bold text-gray-900">{{ (totalAmount / 100)|number_format(0, ',', ' ') }} F</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Payments Table -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Historique des paiements</h3>
        </div>
        {% if payments|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-pink-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Référence</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Utilisateur</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Formation</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Montant</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Statut</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Provider</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-pink-600 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-pink-600 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for payment in payments %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <code class="text-xs bg-gray-100 px-2 py-1 rounded">{{ payment.reference }}</code>
                            </td>
                            <td class="px-6 py-4">
                                {% if payment.customer %}
                                    <div class="text-sm font-medium text-gray-900">{{ payment.customer.fullName }}</div>
                                    <div class="text-xs text-gray-500">{{ payment.customer.email }}</div>
                                {% else %}
                                    <span class="text-sm text-gray-400">Utilisateur supprimé</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-gray-900">{{ payment.description }}</div>
                                <div class="text-xs text-gray-500">ID: {{ payment.entityId }}</div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm font-semibold text-gray-900">
                                    {{ (payment.amount / 100)|number_format(0, ',', ' ') }} {{ payment.currency }}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                {% if payment.status == 'approved' %}
                                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Approuvé</span>
                                {% elseif payment.status == 'pending' %}
                                    <span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">En attente</span>
                                {% elseif payment.status == 'declined' %}
                                    <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">Refusé</span>
                                {% elseif payment.status == 'failed' %}
                                    <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">Échoué</span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">{{ payment.status|title }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                {% if payment.provider == 'feexpay' %}
                                    <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">💸 FeexPay</span>
                                {% elseif payment.provider == 'fedapay' %}
                                    <span class="px-2 py-1 text-xs font-medium bg-indigo-100 text-indigo-800 rounded-full">🏦 FedaPay</span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">{{ payment.provider|title }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">{{ payment.createdAt|date('d/m/Y H:i') }}</td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    {% if payment.status == 'approved' %}
                                        <a href="{{ path('generic_payment_success', {reference: payment.reference}) }}"
                                           class="text-green-600 hover:text-green-900 transition-colors" title="Voir reçu"
                                           target="_blank">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                            </svg>
                                        </a>
                                    {% endif %}
                                    {% if payment.externalTransactionId %}
                                        <span class="text-blue-500" title="ID Transaction: {{ payment.externalTransactionId }}">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                        </span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="px-6 py-12 text-center text-gray-500">Aucun paiement trouvé</div>
        {% endif %}
    </div>
</div>
{% endblock %}
