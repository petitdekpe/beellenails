{% extends 'base.html.twig' %}

{% block title %}Modifier Formation{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <div class="flex">
        <!-- Sidebar -->
        {% include 'components/sidebar.html.twig' %}
        
        <!-- Main Content -->
        <div class="flex-1 lg:ml-2 xl:ml-8">
            <div class="px-2 py-4 sm:px-4 lg:px-6">
                <!-- Header intégré -->
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-gray-900">Modifier Formation</h1>
                    <p class="text-sm text-gray-600">{{ formation.nom }}</p>
                </div>

                <!-- Formulaire de formation -->
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-medium text-gray-900">🎓 Informations de la formation</h2>
                    </div>
                    <div class="px-6 py-6">
                        {{ include('formation/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                    </div>
                </div>

                <!-- Modules -->
                <div class="bg-white rounded-lg shadow mt-6">
                    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                        <h2 class="text-lg font-medium text-gray-900">📚 Modules</h2>
                        <a href="{{ path('app_formation_module_new', {'formationId': formation.id}) }}"
                           class="inline-flex items-center px-4 py-2 bg-pink-600 hover:bg-pink-700 text-white text-sm font-medium rounded-lg transition-colors">
                            + Ajouter un module
                        </a>
                    </div>

                    {% set modules = formation.modules|sort((a, b) => a.position <=> b.position) %}

                    {% if modules|length > 0 %}
                        <div class="divide-y divide-gray-100">
                            {% for module in modules %}
                            <div class="px-6 py-4 flex items-center gap-4">
                                <span class="w-7 h-7 flex-shrink-0 rounded-full bg-pink-100 text-pink-600 text-xs font-bold flex items-center justify-center">
                                    {{ module.position }}
                                </span>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate">{{ module.title }}</p>
                                    <p class="text-xs text-gray-500">
                                        {{ module.formattedDuration }}
                                        {% if module.hasActiveQuiz %}
                                            · <span class="text-indigo-600">📝 Quiz actif ({{ module.quiz.questionsCount }} question{{ module.quiz.questionsCount > 1 ? 's' : '' }})</span>
                                        {% endif %}
                                        {% if not module.isActive %}
                                            · <span class="text-gray-400">Inactif</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="flex items-center gap-2 flex-shrink-0">
                                    <a href="{{ path('app_formation_module_edit', {'formationId': formation.id, 'id': module.id}) }}"
                                       class="p-1.5 text-gray-500 hover:text-pink-600 hover:bg-pink-50 rounded-lg transition-colors"
                                       title="Modifier">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </a>
                                    <form method="POST"
                                          action="{{ path('app_formation_module_delete', {'formationId': formation.id, 'id': module.id}) }}"
                                          onsubmit="return confirm('Supprimer ce module ? Le quiz associé sera également supprimé.')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_module_' ~ module.id) }}">
                                        <button type="submit"
                                                class="p-1.5 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                                                title="Supprimer">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="px-6 py-8 text-center text-gray-400 text-sm">
                            Aucun module. Cliquez sur "Ajouter un module" pour commencer.
                        </div>
                    {% endif %}
                </div>

                <!-- Actions -->
                <div class="mt-6 flex justify-between items-center">
                    <a href="{{ path('app_dashboard_formation') }}" 
                       class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                        ← Retour à la liste
                    </a>
                    
                    <div class="bg-white rounded-lg shadow p-4">
                        <div class="flex items-center space-x-3">
                            <span class="text-sm text-gray-600">Zone de suppression:</span>
                            {{ include('formation/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}