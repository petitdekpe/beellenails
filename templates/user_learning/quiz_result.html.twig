{% extends 'user_learning/base.html.twig' %}

{% block title %}Résultats du quiz - {{ module.title }}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto px-4 py-8">

    <div class="mb-6">
        <p class="text-sm text-gray-500">{{ enrollment.formation.Nom }}</p>
        <h1 class="text-xl font-bold text-gray-900 mt-1">Résultats — {{ module.title }}</h1>
    </div>

    <!-- Score global -->
    <div class="bg-white rounded-lg shadow p-6 mb-6 text-center">
        <div class="w-24 h-24 mx-auto rounded-full flex items-center justify-center text-3xl font-bold mb-4
                    {{ attempt.isPassed ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' }}">
            {{ attempt.score|number_format(0) }}%
        </div>
        <p class="text-lg font-semibold {{ attempt.isPassed ? 'text-green-700' : 'text-red-700' }}">
            {{ attempt.isPassed ? '🎉 Quiz réussi !' : '❌ Quiz non validé' }}
        </p>
        <p class="text-sm text-gray-500 mt-1">
            Score minimum requis : {{ quiz.passingScore }}% —
            Tentative {{ attempt.attemptNumber }}
            {% if not quiz.isUnlimitedAttempts %}/ {{ quiz.maxAttempts }}{% endif %}
        </p>
    </div>

    <!-- Correction par question -->
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Correction</h2>

    {% for attemptAnswer in attempt.attemptAnswers %}
        {% set question = attemptAnswer.question %}
        <div class="bg-white rounded-lg shadow mb-4 p-5
                    border-l-4 {{ attemptAnswer.isCorrectAnswer ? 'border-green-400' : 'border-red-400' }}">

            <p class="font-medium text-gray-900 mb-3">
                <span class="{{ attemptAnswer.isCorrectAnswer ? 'text-green-600' : 'text-red-500' }} mr-2">
                    {{ attemptAnswer.isCorrectAnswer ? '✓' : '✗' }}
                </span>
                {{ question.questionText }}
            </p>

            <div class="space-y-2">
                {% for answer in question.answers %}
                    {% set wasSelected = attemptAnswer.wasAnswerSelected(answer.id) %}
                    <div class="flex items-center gap-3 text-sm px-3 py-2 rounded-lg
                                {% if answer.isCorrect and wasSelected %}bg-green-50 border border-green-200
                                {% elseif answer.isCorrect and not wasSelected %}bg-green-50 border border-green-200 opacity-70
                                {% elseif not answer.isCorrect and wasSelected %}bg-red-50 border border-red-200
                                {% else %}bg-gray-50 border border-gray-100{% endif %}">
                        <span class="w-5 h-5 flex-shrink-0 flex items-center justify-center rounded-full text-xs font-bold
                                     {% if answer.isCorrect %}bg-green-500 text-white
                                     {% elseif wasSelected %}bg-red-500 text-white
                                     {% else %}bg-gray-300 text-gray-600{% endif %}">
                            {% if answer.isCorrect %}✓{% elseif wasSelected %}✗{% else %} {% endif %}
                        </span>
                        <span class="{{ answer.isCorrect ? 'text-green-800 font-medium' : (wasSelected ? 'text-red-700' : 'text-gray-600') }}">
                            {{ answer.answerText }}
                        </span>
                        {% if wasSelected and not answer.isCorrect %}
                            <span class="ml-auto text-xs text-red-500">Votre réponse</span>
                        {% elseif answer.isCorrect and not wasSelected %}
                            <span class="ml-auto text-xs text-green-600">Bonne réponse</span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>

            {% if question.explanation %}
                <div class="mt-3 p-3 bg-blue-50 rounded-lg text-sm text-blue-800">
                    💡 {{ question.explanation }}
                </div>
            {% endif %}
        </div>
    {% endfor %}

    <!-- Actions -->
    <div class="flex gap-3 mt-6">
        <a href="{{ path('app_quiz_attempt_show', {'enrollmentId': enrollment.id, 'moduleId': module.id}) }}"
           class="flex-1 text-center py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors">
            ← Retour au quiz
        </a>
        <a href="{{ path('app_user_learning_formation_detail', {'id': enrollment.id}) }}"
           class="flex-1 text-center py-2.5 bg-pink-600 hover:bg-pink-700 text-white font-medium rounded-lg transition-colors">
            Continuer la formation
        </a>
    </div>

</div>
{% endblock %}
